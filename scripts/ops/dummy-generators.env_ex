# Factory-b/c dummy generator SSH targets.
# These values are consumed by scripts/ops/manage-dummy-generators.sh.

: "${FACTORY_B_MASTER_IP:=REPLACE_FACTORY_B_MASTER_TAILSCALE_IP}"
: "${FACTORY_B_WORKER_IP:=REPLACE_FACTORY_B_WORKER_LAN_IP}"
: "${FACTORY_B_USER:=REPLACE_FACTORY_B_SSH_USER}"

: "${FACTORY_C_MASTER_IP:=REPLACE_FACTORY_C_MASTER_TAILSCALE_IP}"
: "${FACTORY_C_WORKER_IP:=REPLACE_FACTORY_C_WORKER_LAN_IP}"
: "${FACTORY_C_USER:=REPLACE_FACTORY_C_SSH_USER}"

: "${FACTORY_B_SERVICE:=aegis-factory-b-dummy-generator.service}"
: "${FACTORY_B_LEGACY_PUBLISHER_SERVICE:=aegis-factory-b-dummy-publisher.service}"

: "${FACTORY_C_SERVICE:=aegis-factory-c-dummy-generator.service}"
: "${FACTORY_C_LEGACY_PUBLISHER_SERVICE:=aegis-factory-c-dummy-publisher.service}"
